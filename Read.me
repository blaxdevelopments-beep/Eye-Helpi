#
#  main.py
#  Eye~Helpi desktop agent: chat with the local Ollama brain using an
#  agentic tool-calling loop, or serve the same brain + tools over HTTP so
#  the phone and any MCP client can drive this Mac.
#
#  Usage:
#    python main.py chat            # interactive chat with tool calling
#    python main.py serve [--port 8765]
#                                   # HTTP API: GET /api/tools, /api/status,
#                                   #           POST /api/chat, /api/tools/call,
#                                   #           POST /api/uplink
#

import argparse
import json
import os
import sys
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

from config import OLLAMA_HOST, MODEL_NAME, PERSONA, MAX_TOOL_ROUNDS
from tools import TOOL_REGISTRY, tool_schemas, run_tool, record_usage, run_auto_pilot


def _chat_url():
    return OLLAMA_HOST.rstrip("/") + "/api/chat"


def _post_chat(payload):
    request = urllib.request.Request(
        _chat_url(),
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=180) as response:
        return json.loads(response.read().decode())


def _web_tokens():
    """Tokens that unlock the agent over the web: the site's own API key
    (BLAXDEV_API_KEY, set via 'python main.py setkey <token>') and optionally
    a separate EYEHELPI_WEB_TOKEN."""
    tokens = set()
    env_token = os.environ.get("EYEHELPI_WEB_TOKEN", "").strip()
    if env_token:
        tokens.add(env_token)
    try:
        from tools.blax_dev import KEY_FILE
        with open(KEY_FILE) as handle:
            site_key = handle.read().strip()
            if site_key:
                tokens.add(site_key)
    except (ImportError, FileNotFoundError, OSError):
        pass
    return tokens


def chat_round(messages):
    """Agentic round-trip: ask the model, execute any tool calls it requests,
    feed the results back, repeat until it answers or the round budget ends."""
    record_usage("chat")
    for _ in range(MAX_TOOL_ROUNDS):
        payload = {
            "model": MODEL_NAME,
            "messages": messages,
            "stream": False,
            "tools": tool_schemas(),
        }
        try:
            data = _post_chat(payload)
        except Exception as exc:
            return f"I could not reach my brain at {OLLAMA_HOST} ({exc}).", messages

        message = data.get("message", {})
        messages = messages + [message]

        calls = message.get("tool_calls") or []
        if not calls:
            return message.get("content", ""), messages

        for call in calls:
            function = call.get("function", {})
            outcome = run_tool(function.get("name", ""), function.get("arguments"))
            messages = messages + [
                {
                    "role": "tool",
                    "content": json.dumps(outcome, default=str),
                }
            ]

    return "(I ran out of tool rounds - ask me again and I'll be more direct.)", messages


UPLINK_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "uplink.jsonl")
UPLINK_MAX_BYTES = 5 * 1024 * 1024


def store_uplink_batch(items):
    """Opportunistic uplink sink: the phone's Uplink Engine POSTs batches of
    state updates and vector embeddings here. They land appended to a capped
    JSONL file - streamed to disk, never held in memory - so the desktop side
    can inspect or train on them without the agent keeping them in RAM."""
    if not isinstance(items, list):
        raise ValueError("items must be a list")
    for item in items:
        if not isinstance(item, dict):
            raise ValueError("each uplink item must be an object")
    if os.path.exists(UPLINK_FILE) and os.path.getsize(UPLINK_FILE) > UPLINK_MAX_BYTES:
        os.replace(UPLINK_FILE, UPLINK_FILE + ".old")  # rotate, oldest first
    with open(UPLINK_FILE, "a", encoding="utf-8") as handle:
        for item in items:
            handle.write(json.dumps(item, default=str) + "\n")
    return len(items)


def chat():
    print(f"Eye~Helpi agent ready - brain: {MODEL_NAME} at {OLLAMA_HOST}")
    print("Type your commands ('quit' to exit).")
    messages = [{"role": "system", "content": PERSONA}]
    while True:
        try:
            user = input("you> ").strip()
        except (EOFError, KeyboardInterrupt):
            break
        if not user or user.lower() in ("quit", "exit"):
            break
        messages = messages + [{"role": "user", "content": user}]
        reply, messages = chat_round(messages)
        print(f"eye~helpi> {reply}")


def _make_handler():
    class Handler(BaseHTTPRequestHandler):
        def _json(self, code, obj):
            body = json.dumps(obj, default=str).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            # CORS: lets the Eye~Helpi widget on blaxdevelopment.com reach
            # this agent from a visitor's browser.
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
            self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_OPTIONS(self):
            self._json(200, {})

        def _authorized(self):
            """Web access requires the site's API token (Bearer) - the same
            BLAXDEV_API_KEY stored via setkey, or EYEHELPI_WEB_TOKEN."""
            tokens = _web_tokens()
            if not tokens:
                self._json(
                    503,
                    {
                        "error": "web access is locked: no API token is configured on the agent",
                        "fix": "run: python main.py setkey <your blaxdevelopments.com API token>",
                    },
                )
                return False
            header = self.headers.get("Authorization", "")
            presented = header[7:].strip() if header.lower().startswith("bearer ") else ""
            presented = presented or self.headers.get("X-Blax-Api-Key", "").strip()
            if presented and presented in tokens:
                return True
            self._json(
                401,
                {"error": "unauthorized: send the site's API token as 'Authorization: Bearer <token>'"},
            )
            return False

        def do_GET(self):
            if not self._authorized():
                return
            if self.path == "/api/tools":
                self._json(200, {"tools": sorted(TOOL_REGISTRY.keys())})
            elif self.path == "/api/status":
                self._json(200, {"model": MODEL_NAME, "tools": len(TOOL_REGISTRY)})
            else:
                self._json(404, {"error": "not found"})

        def do_POST(self):
            if not self._authorized():
                return
            length = int(self.headers.get("Content-Length") or 0)
            raw = self.rfile.read(length) if length else b"{}"
            try:
                request = json.loads(raw.decode())
            except Exception:
                self._json(400, {"error": "bad json"})
                return

            if self.path == "/api/chat":
                user_messages = [
                    m for m in request.get("messages", []) if m.get("role") != "system"
                ]
                reply, _ = chat_round(
                    [{"role": "system", "content": PERSONA}] + user_messages
                )
                self._json(200, {"reply": reply})
            elif self.path == "/api/tools/call":
                outcome = run_tool(request.get("name", ""), request.get("arguments"))
                self._json(200, {"result": outcome})
            elif self.path == "/api/uplink":
                stored = store_uplink_batch(request.get("items", []))
                self._json(200, {"ok": True, "stored": stored})
            else:
                self._json(404, {"error": "not found"})

        def log_message(self, *args):
            pass

    return Handler


def _autopilot_loop():
    """Predictive watchdog: every 10 minutes, take any granted preventative
    actions without prompting (low-battery protection, disk cleanup)."""
    while True:
        try:
            run_auto_pilot()
        except Exception:
            pass
        time.sleep(600)


def serve(port):
    threading.Thread(target=_autopilot_loop, daemon=True).start()
    server = ThreadingHTTPServer(("0.0.0.0", port), _make_handler())
    print(f"Eye~Helpi agent server on http://0.0.0.0:{port} (tools: {len(TOOL_REGISTRY)})")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(description="Eye~Helpi desktop agent")
    parser.add_argument("mode", nargs="?", default="chat", choices=["chat", "serve", "setkey"])
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("key", nargs="?", help="for setkey: the BLAXDEV_API_KEY value")
    args = parser.parse_args()
    if args.mode == "serve":
        serve(args.port)
    elif args.mode == "setkey":
        from tools import blax_dev_set_key
        if not args.key:
            print("usage: python main.py setkey <your Blax Developments API key>")
            sys.exit(1)
        print(blax_dev_set_key(args.key))
    else:
        chat()


if __name__ == "__main__":
    main()